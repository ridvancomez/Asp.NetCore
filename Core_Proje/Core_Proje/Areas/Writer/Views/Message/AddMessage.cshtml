@model EntityLayer.Concrate.WriterMessage
@{
    ViewData["Title"] = "AddMessage";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Profil Bilgilerini Düzenle</h4>
        @using (Html.BeginForm(FormMethod.Post))
        {
            <div class="form-group">
                <label for="exampleInputName1">Konu</label>
                @Html.TextBoxFor(x => x.Subject, "", htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label for="exampleInputName1">İçerik</label>
                @Html.TextAreaFor(x => x.Message, 3, 5, htmlAttributes: new { @class = "form-control" })
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-lg-7">
                        <label for="exampleInputName1">Alıcı E-Posta</label>
                        @Html.TextBoxFor(x => x.Receiver, "", htmlAttributes: new { @class = "form-control" })
                    </div>
                    <div class="col-lg-5">
                        <label for="exampleInputName1">Alıcı Adı</label>
                        @Html.TextBoxFor(x => x.ReceiverName, "", htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="exampleInputName1">Tarih</label>
                <input type="datetime-local" id="TarihSaat" asp-for="Date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary mr-2">Gönder</button>
            <a href="/Writer/Message/Index" class="btn btn-outline-primary">Geri Dön</a>
        </div>
        }

    </div>
</div>

