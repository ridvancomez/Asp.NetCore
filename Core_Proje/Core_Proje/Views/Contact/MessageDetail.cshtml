@model EntityLayer.Concrate.Message
@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    Dictionary<bool, string> status = new Dictionary<bool, string>
    {
        {true,"Okundu"},
        {false,"Okunmadı"}
    };
    string statusText = "sads";
}

<h3>Mesaj Detayı</h3>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Profil Bilgilerini Düzenle</h4>
        @using (Html.BeginForm())
        {
            <div class="form-group">
                <div class="row">
                    <div class="col-lg-5">
                        <label for="exampleInputName1">Gönderici E-Posta</label>
                        @Html.TextBoxFor(x => x.Name, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
                    </div>
                    <div class="col-lg-7">
                        <label for="exampleInputName1">Gönderici Adı</label>
                        @Html.TextBoxFor(x => x.EMil, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="exampleInputName1">İçerik</label>
                @Html.TextAreaFor(x => x.Content, 3, 5, htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
            </div>


            <div class="form-group">
                <label for="exampleInputName1">Tarih</label>
                @Html.TextBox("Date", Model.Date.ToShortDateString(), htmlAttributes: new { @class = "form-control bg-dark", disabled = ""  })
            </div>

            <div class="form-group">
                <label for="exampleInputName1">Tarih</label>
                @Html.TextBox("Status",status[Model.Status], htmlAttributes: new { @class = "form-control bg-dark", disabled = "", value = "sadada" })
            </div>
        }

        <div class="d-flex justify-content-end">
            <a href="/Writer/Message/Index" class="btn btn-outline-primary">Geri Dön</a>
        </div>
