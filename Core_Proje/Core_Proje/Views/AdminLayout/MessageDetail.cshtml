@model EntityLayer.Concrate.WriterMessage
@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Profil Bilgilerini Düzenle</h4>
        @using (Html.BeginForm())
        {
            <div class="form-group">
                <label for="exampleInputName1">Konu</label>
                @Html.TextBoxFor(x => x.Subject, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
            </div>
            <div class="form-group">
                <label for="exampleInputName1">İçerik</label>
                @Html.TextAreaFor(x => x.Message, 3, 5, htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-lg-7">
                        <label for="exampleInputName1">Gönderici E-Posta</label>
                        @Html.TextBoxFor(x => x.Sender, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
                    </div>
                    <div class="col-lg-5">
                        <label for="exampleInputName1">Gönderici Adı</label>
                        @Html.TextBoxFor(x => x.SenderName, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-lg-7">
                        <label for="exampleInputName1">Alıcı E-Posta</label>
                        @Html.TextBoxFor(x => x.Receiver, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
                    </div>
                    <div class="col-lg-5">
                        <label for="exampleInputName1">Alıcı Adı</label>
                        @Html.TextBoxFor(x => x.ReceiverName, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="exampleInputName1">Tarih</label>
                @Html.TextBoxFor(x => x.Date, "", htmlAttributes: new { @class = "form-control bg-dark", disabled = "" })
            </div>
        }

        <div class="d-flex justify-content-end">
            <a href="/Dashboard/Index" class="btn btn-outline-primary">Dashboard a Git</a>
        </div>
    </div>
</div>


