@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    @await Html.PartialAsync("/Areas/Writer/Views/Default/_HeadPartial.cshtml")
</head>

<body>
    <div class="container-scroller">
        <!-- partial:~/skydash/partials/_navbar.html -->
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <!-- partial:~/skydash/partials/_sidebar.html -->
            @await Html.PartialAsync("/Areas/Writer/Views/Default/_SideBarPartial.cshtml")
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="row">

                        <div class="col-lg-12 grid-margin stretch-card">
                            @await Html.PartialAsync("/Areas/Writer/Views/Default/_NavbarPartial.cshtml")

                            <div class="card">
                                @RenderBody()
                            </div>
                        </div>
                    </div>
                </div>
                <!-- content-wrapper ends -->
                <!-- partial:~/skydash/partials/_footer.html -->
                @await Html.PartialAsync("/Areas/Writer/Views/Default/_FooterPartial.cshtml")
                <!-- partial -->
            </div>
            <!-- main-panel ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    @await Html.PartialAsync("/Areas/Writer/Views/Default/_ScriptPartial.cshtml")

</body>

</html>
