

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-row justify-content-between">
            <h4 class="card-title">Mesajlar</h4>
            <p class="text-muted mb-1 small">Tümünü Görüntüle</p>
        </div>
        <div class="preview-list">

          
                <div class="preview-item border-bottom">
                    <div class="preview-thumbnail">
                        <img src="value.User.ImageUrl" alt="image" class="rounded-circle" />
                    </div>
                    <div class="preview-item-content d-flex flex-grow">
                        <div class="flex-grow">
                            <div class="d-flex d-md-block d-xl-flex justify-content-between">
                                <h6 class="preview-subject">value.User.Name alue.User.Surname</h6>
                                <p class="text-muted text-small">alue.Date.ToString("yyyy-MM-dd")</p>
                            </div>
                            <p class="text-muted">value.Title</p>
                        </div>
                    </div>
                </div>
     

        </div>
    </div>
</div>