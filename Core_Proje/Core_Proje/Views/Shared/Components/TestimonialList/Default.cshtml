@using EntityLayer.Concrate
@model List<Testimonial>

<div class="section px-3 px-lg-4 pt-5" id="testimonials">
    <div class="container-narrow">
        <div class="text-center mb-5">
            <h2 class="marker marker-center">Müşteri Yotumları</h2>
        </div>
        <div class="row">
            @{
                int random = new Random().Next(1, 4);
            }
            @foreach (var value in Model)
            {
                <div class="col-md-6 mb-5" data-aos="fade-right" data-aos-delay="@random*100">
                    <div class="d-flex ms-md-3"><span><i class="fas fa-2x fa-quote-left"></i></span><span class="m-2">@value.Comment</span></div>
                    <div class="d-flex justify-content-end align-items-end">
                        <div class="text-end me-2">
                            <div class="fw-bolder">@value.ClientName</div>
                            <div class="text-small">@value.Company</div>
                        </div><img class="me-md-3 rounded" src="@value.ImageUrl" width="96" height="96" alt="client 1" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>