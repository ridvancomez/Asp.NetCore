@using EntityLayer.Concrate
@model SocialMedia
@{
    ViewData["Title"] = "AddSocialMedia";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Sosyal Medya Ekle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">

        @using (Html.BeginForm(FormMethod.Post))
        {
            <div class="form-group">
                <label class="form-control-label" for="input-username">İsim</label>
                @Html.TextBoxFor(x => x.Name, "", htmlAttributes: new { @class = "form-control text-white", placeholder = "İsim" })
            </div>

            <div class="form-group">
                <label class="form-control-label" for="input-username">Sosyal Medya Linki</label>
                @Html.TextBoxFor(x => x.Url, "", htmlAttributes: new { @class = "form-control text-white", placeholder = "Sosyal Medya Linki" })
            </div>

            <div class="form-group">
                <label class="form-control-label" for="input-username">İkon</label>
                @Html.TextBoxFor(x => x.Icon, "", htmlAttributes: new { @class = "form-control text-white", placeholder = "İkon" })
            </div>

            <div class="form-group">
                <label class="form-control-label" for="input-username">Durum</label>
                @Html.CheckBoxFor(x => x.Status, htmlAttributes: new { @class = "form-control text-white", placeholder = "Yetenek Adı" })
            </div>

            <div class="text-left">
                <button class="btn btn-primary h-100" type="submit">Kaydet</button>
            </div>
        }

    </div>

</div>

