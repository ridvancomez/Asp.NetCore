
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using EntityLayer.Concrate
@model About
<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Deneyim Düzenle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            @Html.HiddenFor(value => Model.AboutId)
            <h6 class="heading-small text-muted mb-4">Deneyim Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">Başlık</label>
                            @Html.TextBoxFor(value => Model.Title, htmlAttributes: new { @class = "form-control", placeholder = "Başlık" })
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Yaş</label>
                            @Html.TextBoxFor(value => Model.Age, htmlAttributes: new { @class = "form-control", placeholder = "Yaş" })

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12">
                        <div class="form-group">

                            <label class="form-control-label" for="input-username">Açıklama</label>
                            @Html.TextAreaFor(value => Model.Description,5,5, htmlAttributes: new { @class = "form-control", placeholder = "Açıklama" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">E Posta</label>
                            @Html.TextBoxFor(value => Model.Email, htmlAttributes: new { @class = "form-control", placeholder = "E Posta" })
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Telefon</label>
                            @Html.TextBoxFor(value => Model.Phone, htmlAttributes: new { @class = "form-control", placeholder = "Telefon" })

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">Adress</label>
                            @Html.TextBoxFor(value => Model.Address, htmlAttributes: new { @class = "form-control", placeholder = "Adress" })
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Resim Yolu</label>
                            @Html.TextBoxFor(value => Model.Image, htmlAttributes: new { @class = "form-control", placeholder = "Resim Yolu" })

                        </div>
                    </div>
                </div>

                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        }
    </div>
</div>

