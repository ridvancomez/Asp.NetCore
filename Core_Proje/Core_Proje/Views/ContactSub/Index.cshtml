@using EntityLayer.Concrate
@model Contact
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">İletişim Bilgisi Düzenle</h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            <div class="form-group">
                <label class="form-control-label" for="input-username">Başlık</label>
                @Html.HiddenFor(x => x.ContactId)
                @Html.TextBoxFor(x => x.Title, "", htmlAttributes: new { @class = "form-control text-white" })
            </div>
            <div class="form-group">
                <label class="form-control-label" for="input-username">Açıklama</label>
                @Html.TextAreaFor(x => x.Description, 5,3, htmlAttributes: new { @class = "form-control text-white" })
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="form-control-label" for="input-username">E Posta</label>
                        @Html.TextBoxFor(x => x.Mail, "", htmlAttributes: new { @class = "form-control text-white", @type="mail" })
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="form-control-label" for="input-username">Telefon Numarası</label>
                        @Html.TextBoxFor(x => x.PhonNumber, "", htmlAttributes: new { @class = "form-control text-white", @type = "mail" })

                    </div>
                </div>
            </div>
            <div class="text-left">
                <button class="btn btn-primary h-100" type="submit">Kaydet</button>
            </div>
        }
    </div>
</div>

