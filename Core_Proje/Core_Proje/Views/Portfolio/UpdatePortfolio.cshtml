
@{
    ViewData["Title"] = "UpdatePortfolio";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using EntityLayer.Concrate
@model Portfolio
<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Deneyim Düzenle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            @Html.HiddenFor(value => Model.PortfolioId)
            <h6 class="heading-small text-muted mb-4">Deneyim Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">

                            <label class="form-control-label" for="input-username">İsim</label>
                            @Html.TextBoxFor(value => Model.Name, htmlAttributes: new { @class = "form-control", placeholder = "İsim" })
                            @Html.ValidationMessageFor(value => Model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Proje Yolu</label>
                            @Html.TextBoxFor(value => Model.ProjectUrl, htmlAttributes: new { @class = "form-control", placeholder = "Proje Yolu" })
                            @Html.ValidationMessageFor(value => Model.ProjectUrl, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">

                            <label class="form-control-label" for="input-username">Resim Yolu</label>
                            @Html.TextBoxFor(value => Model.ImageUrl, htmlAttributes: new { @class = "form-control", id = "input-username", placeholder = "Resim Yolu" })
                            @Html.ValidationMessageFor(value => Model.ImageUrl, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Büyük Resim Yolu"</label>
                            @Html.TextBoxFor(value => Model.ImageUrl2, htmlAttributes: new { @class = "form-control", id = "input-username", placeholder = "Büyük Resim Yolu" })
                            @Html.ValidationMessageFor(value => Model.ImageUrl2, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        }
    </div>
</div>

