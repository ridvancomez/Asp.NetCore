@{
    ViewData["Title"] = "AddPortfolio";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@using EntityLayer.Concrate
@model Portfolio

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Yetenek Ekle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            <h6 class="heading-small text-muted mb-4">Deneyim Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            @Html.Label("Name", "İsim", htmlAttributes: new { @class = "form-control-label" })
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "İsim" })
                            @Html.ValidationMessageFor(m => m.Name)
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            @Html.Label("ImageUrl", "Resim Yolu", htmlAttributes: new { @class = "form-control-label" })
                            @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", @placeholder = "Resim Yolu" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            @Html.Label("ImageUrl2", "Büyük Resim Yolu", htmlAttributes: new { @class = "form-control-label" })
                            @Html.TextBoxFor(@m => m.ImageUrl2, new { @class = "form-control", @placeholder = "Büyük Resim Yolu" })
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            @Html.Label("ProjectUrl", "Proje Yolu", htmlAttributes: new { @class = "form-control-label" })
                            @Html.TextBoxFor(@m => m.ProjectUrl, new { @class = "form-control", @placeholder = "Proje Yolu" })
                        </div>
                    </div>
                </div>
                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        }
    </div>
</div>



