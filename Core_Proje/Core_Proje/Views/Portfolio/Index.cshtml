
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@using EntityLayer.Concrate
@model List<Portfolio>
<div class="card-header border-0">
    <div style="display:flex; align-items:center; justify-content:space-between; ">
        <div>
            <h3 class="mb-0">Deneyim Listesi Tablosu</h3>
        </div>
        <div>
            <a href="/Portfolio/AddPortfolio" class="btn btn-primary h-100" type="submit">Pörtföy Ekle</a>

        </div>

    </div>
</div>
<!-- Light table -->
<div class="table-responsive">
    <table class="table align-items-center table-flush">
        <thead class="thead-light">
            <tr>
                <th scope="col" class="sort" data-sort="name">#</th>
                <th scope="col" class="sort" data-sort="budget">Başlık</th>
                <th scope="col">Sil</th>
                <th scope="col" class="sort" data-sort="completion">Güncelle</th>
            </tr>
        </thead>
        <tbody class="list">
            @foreach (var value in Model)
            {
                <tr>
                    <th>
                        @value.PortfolioId
                    </th>
                    <td class="budget">
                        @value.Name
                    </td>
                    <td>
                        <button onclick="Delete(@value.PortfolioId)" class="btn btn-danger text-white">Sil</button>
                    </td>
                    <td>
                        <a href="/Portfolio/UpdatePortfolio/@value.PortfolioId" class="btn btn-warning text-white">Güncelle</a>

                    </td>
                </tr>
            }

    </table>
</div>

<script>
    function Delete(id) {
        if(confirm("Silmek İstediğinize Emin Misiniz"))
        {
            $.ajax({
                url: "/Portfolio/DeletePortfolio",
                type: "POST",
                data: { id: id },
                success: function (data) {
                    alert("Silme İşlemi Başarılı");
                    location.reload();
                }
            });
        }
    };
</script>