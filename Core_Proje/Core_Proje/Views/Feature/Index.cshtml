@{

    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using EntityLayer.Concrate
@model Feature
<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Deneyim Düzenle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            @Html.HiddenFor(value => Model.FeatureId)
            <h6 class="heading-small text-muted mb-4">Deneyim Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">

                            <label class="form-control-label" for="input-username">Başlık</label>
                            @Html.TextBoxFor(value => Model.Header, htmlAttributes: new { @class = "form-control", placeholder = "Başlık" })

                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">İsim</label>
                            @Html.TextBoxFor(value => Model.Name, htmlAttributes: new { @class = "form-control", placeholder = "İsim" })

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">

                            <label class="form-control-label" for="input-username">Ünvan</label>
                            @Html.TextBoxFor(value => Model.Title, htmlAttributes: new { @class = "form-control", placeholder = "Ünvan" })

                        </div>
                    </div>
                </div>

                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        }
    </div>
</div>