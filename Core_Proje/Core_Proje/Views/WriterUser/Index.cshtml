@model List<EntityLayer.Concrate.WriterUser>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-6">
        <div class="p-2">
            <button type="button" id="btnGetLlistAll" class="btn btn-outline-primary">Verileri Getir</button>
            <button type="button" id="btnAddUser" class="btn btn-outline-Success">Ekle</button>
        </div>
    </div>

</div>

<h4 class="text-center">Yazarlar</h4>
<div class=" p-2" id="listuser">
    buraya veriler gelecek
</div>

<div class="col-lg-12">
    <input type="text" class="form-control" id="inpName" placeholder="Ad" />
    <br />
    <input type="text" class="form-control" id="inpSurName" placeholder="Soyad" />
    <br />
    <input type="text" class="form-control" id="inpUserName" placeholder="Kullanıcı Adı" />
    <br />
    <input type="text" class="form-control" id="inpMail" placeholder="mail" />
    <br />
</div>

@section Scripts {
    <script>
        $('#btnGetLlistAll').click(function() {
            $.ajax({
                contentType: "application/json",
                dataType: "json",
                type: "GET",
                url: "/WriterUser/WriterUserList",

               success:function(func)
               {
                   let users = jQuery.parseJSON(func);
                   console.log(users);
               }

            })
        
        });

        $('#btnAddUser').click(function()
        {
            $.ajax({
                contentType : "application/json",
                dataType: "json",
                type: "POST",
                url: "/WriterUser/AddWriterUser",
                success: function(func)
                {
                    let user = jQuery.parseJSON(func);
                    console.log(user);
                }
            })
        })
    </script>
}

<script src="~/lib/jquery/dist/jquery.js"></script>