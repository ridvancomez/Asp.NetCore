
@{
    ViewData["Title"] = "UpdateTestimonial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using EntityLayer.Concrate
@model Testimonial

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Referans Düzenle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="form-control-label" for="input-username">Müşteri Adı</label>
                        @Html.HiddenFor(x => x.TestimonialId)
                        @Html.TextBoxFor(x => x.ClientName, "", htmlAttributes: new { @class = "form-control text-white", placeholder = "Müşteri Adı" })
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="form-control-label" for="input-email">Title</label>
                        @Html.TextBoxFor(x => x.Company, "", htmlAttributes: new { @class = "form-control text-white", placeholder = "Title" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-control-label" for="input-email">Yorum</label>
                @Html.TextAreaFor(x => x.Comment, 5, 3, htmlAttributes: new { @class = "form-control text-white", placeholder = "Yorum" })
            </div>

            <div class="form-group">
                <label class="form-control-label" for="input-email">Resim Yolu</label>
                @Html.TextBoxFor(x => x.ImageUrl, "", htmlAttributes: new { @class = "form-control text-white", placeholder = "Resim Yolu" })
            </div>
            <div class="text-left">
                <button class="btn btn-primary h-100" type="submit">Kaydet</button>
            </div>
        }
    </div>
</div>

