@{
    ViewData["Title"] = "AddExperience";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Yetenek Ekle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form method="post">
            <h6 class="heading-small text-muted mb-4">Deneyim Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">İsim</label>
                            <input type="text" id="input-username" class="form-control" name="Name" placeholder="İsim">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Tarih</label>
                            <input type="text" id="input-email" class="form-control" name="Date" placeholder="Tarih">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">Resim Yolu</label>
                            <input type="text" id="input-username" class="form-control" name="ImageUrl" placeholder="Resim Yolu">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Başlık</label>
                            <input type="text" id="input-email" class="form-control" name="Title" placeholder="Başlık">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">Açıklama</label>
                            <textarea class="form-control" name="Description" placeholder="Açıklama" rows="5"></textarea>
                            
                        </div>
                    </div>
                </div>
                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>

