@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@using EntityLayer.Concrate
@model List<Experience>

<div class="card-header border-0">
    <div style="display:flex; align-items:center; justify-content:space-between; ">
        <div>
            <h3 class="mb-0">Deneyim Listesi Tablosu</h3>
        </div>
        <div>
            <a href="/Experience/AddExperience" class="btn btn-primary h-100" type="submit">Deneyim Ekle</a>

        </div>

    </div>
</div>
<!-- Light table -->
<div class="table-responsive">
    <table class="table align-items-center table-flush">
        <thead class="thead-light">
            <tr>
                <th scope="col" class="sort" data-sort="name">#</th>
                <th scope="col" class="sort" data-sort="budget">Başlık</th>
                <th scope="col" class="sort" data-sort="status">Tarih</th>
                <th scope="col">Sil</th>
                <th scope="col" class="sort" data-sort="completion">Güncelle</th>
            </tr>
        </thead>
        <tbody class="list">
            @foreach (var value in Model)
            {
                <tr>
                    <th>
                        @value.ExperienceId
                    </th>
                    <td class="budget">
                        @value.Name
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <span class="completion mr-2">@value.Title</span>
                        </div>
                    </td>
                    <td>
                        <a href="/Experience/DeleteExperience/@value.ExperienceId" class="btn btn-danger text-white">Sil</a>
                    </td>
                    <td>
                        <a href="/Experience/UpdateExperience/@value.ExperienceId" class="btn btn-warning text-white">Güncelle</a>

                    </td>
                </tr>
            }

    </table>
</div>

