@{
    ViewData["Title"] = "UpdateSkill";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@using EntityLayer.Concrate
@model Skill
<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Yetenek Düzenle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            <h6 class="heading-small text-muted mb-4">Yetenek Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            @Html.HiddenFor(value => Model.SkillId)
                            <label class="form-control-label" for="input-username">Yetenke Adı</label>
                            @Html.TextBoxFor(value => Model.Title, htmlAttributes: new { @class = "form-control", id = "input-username", placeholder = "Yetenek Adı" })

                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Değer</label>
                            @Html.TextBoxFor(value => Model.Value, htmlAttributes: new
                                {
                                    @class = "form-control",
                                    placeholder = "Yetenek Adı",
                                    min = "0",
                                    max = "100",
                                    type = "number"
                                })

                         </div>
                    </div>
                </div>
                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        }
        <form method="post">
        </form>
    </div>
</div>

