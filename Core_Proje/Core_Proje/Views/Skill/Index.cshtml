@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@using EntityLayer.Concrate
@model List<Skill>

<div class="card-header border-0">
    <div style="display:flex; align-items:center; justify-content:space-between; ">
        <div>
            <h3 class="mb-0">Yetenek Listesi Tablosu</h3>
        </div>
        <div >
            <a href="/Skill/AddSkill" class="btn btn-primary h-100" type="submit">Yetenek Ekle</a>
            
        </div>

    </div>
</div>
<!-- Light table -->
<div class="table-responsive">
    <table class="table align-items-center table-flush">
        <thead class="thead-light">
            <tr>
                <th scope="col" class="sort" data-sort="name">#</th>
                <th scope="col" class="sort" data-sort="budget">Başlık</th>
                <th scope="col" class="sort" data-sort="status">Oran</th>
                <th scope="col">Sil</th>
                <th scope="col" class="sort" data-sort="completion">Güncelle</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody class="list">
            @foreach (var value in Model)
            {
                <tr>
                    <th>
                        @value.SkillId
                    </th>
                    <td class="budget">
                        @value.Title
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <span class="completion mr-2">@value.Value%</span>
                            <div>
                                <div class="progress m-0 p-0">
                                    <div class="progress-bar bg-success" role="progressbar" aria-valuenow="@value.Value" aria-valuemin="0" aria-valuemax="100" style="width: @value.Value%;"></div>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <a href="/Skill/DeleteSkill/@value.SkillId" class="btn btn-danger text-white">Sil</a>
                    </td>
                    <td>
                        <a href="/Skill/UpdateSkill/@value.SkillId" class="btn btn-warning text-white">Güncelle</a>

                    </td>
                </tr>
            }

    </table>
</div>