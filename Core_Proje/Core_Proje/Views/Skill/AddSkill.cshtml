@{
    ViewData["Title"] = "AddSkill";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-8">
                <h3 class="mb-0">Yetenek Ekle </h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form method="post">
            <h6 class="heading-small text-muted mb-4">Yetenek Bilgileri</h6>
            <div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-username">Yetenke Adı</label>
                            <input type="text" id="input-username" class="form-control" name="Title" placeholder="Yetenek Adı">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-control-label" for="input-email">Değer</label>
                            <input type="number" id="input-email" class="form-control" name="Value" min="0" max="100" placeholder="Değer">
                        </div>
                    </div>
                </div>
                <div class="text-left">
                    <button class="btn btn-primary h-100" type="submit">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>